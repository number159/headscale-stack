# Only keys that differ from headscale's defaults. Full annotated reference:
# https://github.com/juanfont/headscale/blob/main/config-example.yaml
server_url: https://hs.example.com          # CHANGEME: must match tls_letsencrypt_hostname
listen_addr: 0.0.0.0:443                    # headscale terminates TLS itself
tls_letsencrypt_hostname: hs.example.com    # CHANGEME
tls_letsencrypt_challenge_type: HTTP-01     # answered on :80

prefixes:
  v4: 100.64.0.0/10
  v6: fd7a:115c:a1e0::/48

noise:
  private_key_path: /var/lib/headscale/noise_private.key

database:
  type: sqlite
  sqlite:
    path: /var/lib/headscale/db.sqlite

derp:
  server:
    enabled: true
    region_id: 999
    region_code: headscale
    region_name: Headscale Embedded DERP
    verify_clients: true
    stun_listen_addr: 0.0.0.0:3478
    private_key_path: /var/lib/headscale/derp_server_private.key
    # ipv4: <VM public IPv4>
    # ipv6: <VM public IPv6>
  urls:
    - https://controlplane.tailscale.com/derpmap/default   # public relays as fallback; [] = own relay only

policy:
  mode: file
  path: /etc/headscale/acl.hujson

dns:
  magic_dns: true
  base_domain: tailnet.internal
  override_local_dns: true
  nameservers:
    global: [1.1.1.1, 1.0.0.1]

oidc:
  only_start_if_oidc_is_available: true
  issuer: https://accounts.google.com       # CHANGEME: your IdP issuer URL
  client_id: CHANGEME
  client_secret: CHANGEME
  allowed_domains: [example.com]            # CHANGEME: or allowed_users / allowed_groups
  pkce:
    enabled: true
    method: S256
