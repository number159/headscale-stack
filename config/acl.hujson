{
  // CHANGEME: admin emails as they appear in the IdP
  "groups": {
    "group:admin": ["you@example.com"],
  },
  "acls": [
    // admins reach everything
    {"action": "accept", "src": ["group:admin"], "dst": ["*:*"]},
    // every member reaches only their own devices
    {"action": "accept", "src": ["autogroup:member"], "dst": ["autogroup:self:*"]},
  ],
}
